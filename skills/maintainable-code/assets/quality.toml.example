# Language-neutral template. Replace placeholder argv values with existing
# repository check commands and confirm their exit codes before adopting.
version = 1

[snapshot]
# Cover source, tests, policy, manifests, lockfiles, and tool configuration.
# The default ["."] also covers untracked files. Exclude generated output only.
paths = ["."]
exclude = [".venv", "node_modules", "dist", "build", ".coverage", "htmlcov"]

[[commands]]
id = "lint"
argv = ["<lint-executable>", "<check-only-argument>"]
modes = ["fast", "full"]
timeout = 120
severity = "error"
failure_codes = [1]

[[commands]]
id = "tests"
argv = ["<test-executable>", "<argument>"]
modes = ["full"]
timeout = 300
severity = "error"

# Uncomment when the repository has an architecture-check command.
# Keep boundary definitions in that tool's existing configuration.
# [[commands]]
# id = "ARCH-DOMAIN"
# argv = ["<architecture-check-executable>", "<argument>"]
# severity = "error"
# policy = "docs/architecture.md#dependency-direction"
